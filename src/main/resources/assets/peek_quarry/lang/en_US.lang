# PEEK Quarry - en_US
# §a is the vanilla colour code for green. The lang file is UTF-8 and .lang has no
# \u escapes, so the section sign has to be a literal U+00A7.
tile.peek_quarry.ender_touch.name=§aEnder's Touch

